; 書き出し設定のテンプレート。各自 export_presets.cfg にコピーして使う。
; 本物の export_presets.cfg は署名パスワードを平文で持つため、リポジトリに入れない（.gitignore で除外）。
; このファイルには署名の項目を書かない。デバッグ版の署名は、エディタ設定のデバッグ用の鍵を使う。

[preset.0]

name="Android (debug)"
platform="Android"
runnable=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="content/*.json, assets/fonts/*/OFL.txt, assets/models/*/*.json"
exclude_filter="tests/*, addons/gdUnit4/*"
export_path="export/soccer-game-debug.apk"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

gradle_build/use_gradle_build=false
architectures/armeabi-v7a=false
architectures/arm64-v8a=true
architectures/x86=false
architectures/x86_64=true
package/unique_name="com.example.soccergame"
package/name="soccer-game"
screen/immersive_mode=true
permissions/internet=false

; ブラウザで遊ぶ版（PWA）。リポジトリ直下の GitHub Pages の /game/ に載せる（CI が書き出す）。
; GitHub Pages は COOP/COEP ヘッダーを付けられないので、スレッドを使わない版にする。
[preset.1]

name="Web"
platform="Web"
runnable=true
dedicated_server=false
custom_features=""
export_filter="all_resources"
include_filter="content/*.json, assets/fonts/*/OFL.txt, assets/models/*/*.json"
exclude_filter="tests/*, addons/gdUnit4/*"
export_path="export/web/index.html"
encryption_include_filters=""
encryption_exclude_filters=""
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.1.options]

variant/extensions_support=false
variant/thread_support=false
vram_texture_compression/for_desktop=true
vram_texture_compression/for_mobile=true
html/export_icon=true
html/canvas_resize_policy=2
html/focus_canvas_on_start=true
html/experimental_virtual_keyboard=false
progressive_web_app/enabled=true
progressive_web_app/ensure_cross_origin_isolation_headers=false
progressive_web_app/display=0
progressive_web_app/orientation=1
progressive_web_app/background_color=Color(0.02745098, 0.050980393, 0.09411765, 1)
