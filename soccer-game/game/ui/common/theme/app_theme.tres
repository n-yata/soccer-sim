[gd_resource type="Theme" load_steps=28 format=3]

; アプリ全体のテーマ（project.godot の gui/theme/custom）。各画面は色を直接書かない。
; 色は docs/specs/3_detail-design/screen/screen-common.md §3 の写し（bg #070D18・surface #101827・text #F8FAFC・
; text_sub #CBD5E1・muted #94A3B8・accent #F5C518・you #4CC3FF・disabled_bg #1E293B・disabled_text #94A3B8・
; pitch #165C34・pitch_line #F8FAFC（80%）・zone_line #F8FAFC（25%））。正本を変えたらここも合わせる。
; ホバーの見た目は通常と同じにする（screen-common.md §4.1。タッチには無い状態で、Android ではタップ後も残るため）。
; フォーカスの枠も出さない（タッチでは不要で、タップ後にも残るため。キーボード操作は Windows 版の範囲）。
; 日本語は Noto Sans JP（画面の文言に絞ったサブセット。tools/subset_noto_sans_jp.py）。端末のフォントに頼らない（ブラウザ版には端末のフォントが無い）。
; Barlow Condensed の見出しは、日本語の字を Noto Sans JP の Bold で表示する（下の FontVariation の fallbacks）。

[ext_resource type="FontFile" path="res://assets/fonts/barlow-condensed/BarlowCondensed-Bold.ttf" id="1_barlow_bold"]
[ext_resource type="FontFile" path="res://assets/fonts/barlow-condensed/BarlowCondensed-SemiBold.ttf" id="2_barlow_semibold"]
[ext_resource type="FontFile" uid="uid://cnwbsj87xjk8i" path="res://assets/fonts/noto-sans-jp/NotoSansJP-Regular.woff2" id="3_noto_regular"]
[ext_resource type="FontFile" uid="uid://nfjsykdgqfqq" path="res://assets/fonts/noto-sans-jp/NotoSansJP-Bold.woff2" id="4_noto_bold"]

[sub_resource type="FontVariation" id="barlow_bold_ja"]
fallbacks = Array[Font]([ExtResource("4_noto_bold")])
base_font = ExtResource("1_barlow_bold")

[sub_resource type="FontVariation" id="barlow_semibold_ja"]
fallbacks = Array[Font]([ExtResource("4_noto_bold")])
base_font = ExtResource("2_barlow_semibold")

