6;" vertex="1" parent="1"><mxGeometry x="56" y="756" width="218" height="128" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-74" value="&lt;b&gt;SIM-04 …&lt;/b&gt;&lt;br&gt;ゲームでは: …&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="282" y="756" width="218" height="128" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-75" value="完了" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="844" width="322" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-76" value="&lt;b&gt;配置&lt;/b&gt;: 試合画面と同じ（左に作戦ボード、右の操作の列）。説明文の吹き出しは操作の列の上端。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-77" value="&lt;b&gt;やめる&lt;/b&gt;: 確認ダイアログ → S-01 へ。完了フラグは変えない。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="166" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-78" value="&lt;b&gt;説明文&lt;/b&gt;: 段階の定義（tutorial.json）。選べる手は段階の定義で絞る。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="206" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-79" value="&lt;b&gt;次へ&lt;/b&gt;: 操作を求める段階では、操作して判定理由が出るまで押せない。判定理由を出すと「決定」は隠れ、「次へ」だけになる。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="262" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-80" value="&lt;b&gt;完了&lt;/b&gt;: 完了フラグを保存して S-01 へ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="318" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-81" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="368" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-82" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="374" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-83" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="398" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-84" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;