eight="44" as="geometry"/></mxCell><mxCell id="wireframe-s12-settings-22" value="&lt;b&gt;音量&lt;/b&gt;: 0〜100。変えた時点で再生中の音に反映し、保存する。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s12-settings-23" value="&lt;b&gt;ヒント表示&lt;/b&gt;: 初期値 ON（FR-15）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="150" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s12-settings-24" value="&lt;b&gt;ライセンス&lt;/b&gt;: 同梱フォントなどのライセンス本文を開く。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="190" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s12-settings-25" value="&lt;b&gt;保存失敗&lt;/b&gt;: 画面下部に短い通知。画面上の値は保持。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s12-settings-26" value="&lt;b&gt;戻る&lt;/b&gt;: S-01 へ。試合中のメニューから開いた場合は閉じて試合へ戻る。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="270" width="460" height="30" as="geometry"/></mxCell><mxCell id="wireframe-s12-settings-27" value=