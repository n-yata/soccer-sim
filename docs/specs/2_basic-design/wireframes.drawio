="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-84" value="③ 攻撃方式" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="542" width="328" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-85" value="保持型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56.0" y="566" width="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-86" value="カウンター型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220.0" y="566" width="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-87" value="&lt;b&gt;④ 解説&lt;/b&gt;&lt;br&gt;4-3-3: 前線3人で幅を取り、両ウイングが大外に張る。中盤は3人で中央を締める……&lt;br&gt;ゾーン: ボールサイドへ1レーンずれて圧縮する。逆サイドは手薄になる……&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="626" width="328" height="140" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-88" value="この布陣で試合開始" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#E2E8F0;fontSize=14;fontColor=#64748B;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="846" width="328" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-89" value="&lt;b&gt;① 陣形カード&lt;/b&gt;（4つ、2×2）&lt;br&gt;ミニピッチは基本配置の人数（攻撃方向が上）。選んだカードに枠と ✓。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="440" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-90" value="&lt;b&gt;②③ 方式&lt;/b&gt;&lt;br&gt;2択。どちらも未選択から始める。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="176" width="440" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-91" value="&lt;b&gt;④ 解説&lt;/b&gt;&lt;br&gt;選んだ項目の解説だけを出す（相手は未定なので単独の解説）。&lt;br&gt;単純化に関わる記述には「実戦では」を添える。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="242" width="440" height="73" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-92" value="&lt;b&gt;開始ボタン&lt;/b&gt;&lt;br&gt;3項目すべてを選ぶまで押せない（図は ③ 未選択の状態）。&lt;br&gt;押すと S-03 へ。試合画面で両者の陣形・方式を開示する。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="325" width="440" height="73" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-93" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="418" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-94" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="424" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-95" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="448" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-96" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="518" y="448" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-97" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="474" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-98" value="条件付きで表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="518" y="474" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-99" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="496" width="40" height="12" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-100" va