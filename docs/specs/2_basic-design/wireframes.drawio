lue="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#81C784;fontSize=10;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="336" y="338" width="140" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-36" value="負1" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#81C784;fontSize=10;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="336" y="394" width="140" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-37" value="攻撃→" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="416" y="452" width="60" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-38" value="&lt;b&gt;局面別（局面別タブ）&lt;/b&gt;&lt;br&gt;攻撃　　勝6 負3 膠2&lt;br&gt;守備　　勝4 負5 膠1&lt;br&gt;ネガトラ　勝1 負2&lt;br&gt;ポジトラ　勝2 負1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="510" y="170" width="322" height="240" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-39" value="▼ 失点　前半 6ターン目（0 − 1）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;fontSize=13;fontColor=#DC2626;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="56" y="600" width="300" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-40" value="▲ 得点　後半 3ターン目（1 − 1）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=13;fontColor=#2563EB;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="656" width="300" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-41" value="3: 自分 ショートパス→M2-C ／ CPU カバー→M2-C → 膠着&lt;br&gt;&lt;span style='color:#64748B'&gt;[ミニピッチ＋動きの矢印]　判定理由…&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="370" y="600" width="454" height="88" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-42" value="4: 自分 サイドチェンジ→M2-R2 ／ CPU プレス→M2-R2 → ロスト&lt;br&gt;&lt;span style='color:#64748B'&gt;[ミニピッチ＋動きの矢印]　判定理由…&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="370" y="696" width="454" height="88" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-43" value="5: トランジション 自分 即時奪回 ／ CPU カウンター→A1-L2 → 前進&lt;br&gt;&lt;span style='color:#64748B'&gt;[ミニピッチ＋動きの矢印]　判定理由…&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="370" y="792" width="454" height="88" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-44" value="&lt;b&gt;エリア別&lt;/b&gt;: 作戦ボードと同じ向き（6列が下から上、5レーンが左右）の盤面に、勝ち・負け・膠着の数（アルゴリズム10）。判定の無かったエリアは空欄。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-45" value="&lt;b&gt;得失点の流れ&lt;/b&gt;: 左に得点ごとのカード、右に選んだ得点の直前のターン（遡るターン数は設定値）を順に表示。単純化に関わるターンには「実戦では」。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="166" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-46" value="&lt;b&gt;時間帯&lt;/b&gt;: 両チームの陣形・方式が同じだった時間帯の一覧。戻るで S-06 へ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="222" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-47" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="288" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-48" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="294" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-49" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="318" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-50" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="318" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s07-review-51" value="" style