 id="wireframe-s08-tutorial-34" value="このゲームが表現していないこと" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="476" y="178" width="328" height="24" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-35" value="&lt;b&gt;SIM-01 …&lt;/b&gt;&lt;br&gt;ゲームでは: …&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="476" y="210" width="328" height="110" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-36" value="&lt;b&gt;SIM-02 …&lt;/b&gt;&lt;br&gt;ゲームでは: …&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="476" y="330" width="328" height="110" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-37" value="&lt;b&gt;SIM-03 …&lt;/b&gt;&lt;br&gt;ゲームでは: …&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="476" y="450" width="328" height="110" as="geometry"/></mxCell><mxCell id="wireframe-s08-tutorial-38" value="&lt;b&gt;SIM-04 …&lt;/b&gt;&lt;br&gt;ゲームでは: …&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">