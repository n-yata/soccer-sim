"geometry"/></mxCell><mxCell id="wireframe-s06-result-6" value="試合結果" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="118" width="180" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-7" value="勝ち" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=36;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="360" height="50" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-8" value="自分 2 − 1 CPU" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="360" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-9" value="&lt;b&gt;陣形・方式の推移&lt;/b&gt;&lt;br&gt;前半: 4-3-3 ゾーン・保持型 対 4-4-2 マンツーマン・カウンター型&lt;br&gt;後半: 4-2-3-1 ゾーン・カウンター型 対 4-4-2 マンツーマン・カウンター型&lt;br&gt;後半 4ターン目: CPU が方式を変更" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="360" width="328" height="120" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-10" value="振り返り" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="786" width="328" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-11" value="タイトルへ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=14;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="846" width="328" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-12" value="&lt;b&gt;勝敗&lt;/b&gt;&lt;br&gt;勝ち／引き分け／負けを文字で示す（色だけに頼らない）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="420" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-13" value="&lt;b&gt;タイトルへ&lt;/b&gt;&lt;br&gt;S-01 へ。終了処理（戦績の記録）が済んでいれば中断データを削除。&lt;br&gt;済んでいなければやり直し、なお失敗したら残して通知。Android の戻る操作も同じ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="176" width="420" height="73" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-14" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="269" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-15" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="275" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s06-result-16" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="299" width="40" height="18" as