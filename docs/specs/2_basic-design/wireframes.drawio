<mxfile host="drawio" pages="12"><diagram id="wireframe-s01-title" name="wireframe-s01-title"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wireframe-s01-title-1" value="S-01 タイトル" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="28" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-2" value="左にスタジアムの絵とプロダクト名、右の列にカード（タイル）。中断中の試合があるときだけ再開カード。チュートリアル未完了なら CPU 対戦の直前に「はじめての方へ」。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1200" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-3" value="横向き（Android）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="800" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="360" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-5" value="スタジアムの絵（夜の照明・芝・白線・選手の駒）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=none;fontSize=11;fontColor=#CBD5E1;align=center;verticalAlign=bottom;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="400" height="360" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-6" value="MATCHDAY TACTICS" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C518;strokeColor=none;fontSize=10;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="180" width="120" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-7" value="&lt;span style='color:#FFFFFF'&gt;[プロダクト名]&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=24;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="206" width="360" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-8" value="&lt;span style='color:#CBD5E1'&gt;読み合いで戦術を学ぶボードゲーム&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="248" width="360" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-9" value="&lt;b&gt;RESUME　中断した試合を再開&lt;/b&gt;&lt;br&gt;前半 7／15・4-3-3 対 4-4-2　　&lt;b&gt;1 − 0&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F5C518;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="456" y="122" width="368" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-10" value="&lt;b&gt;チュートリアル&lt;/b&gt;　&lt;span style='color:#B45309'&gt;はじめての方へ&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;ピッチ・局面・読み合いを、操作して覚える&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="456" y="186" width="368" height="52" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-11" value="&lt;b&gt;KICK OFF&lt;/b&gt;&lt;br&gt;CPU 対戦" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C518;strokeColor=#F5C518;fontSize=16;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="456" y="246" width="368" height="68" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-12" value="①" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;ellipse;" vertex="1" parent="1"><mxGeometry x="798" y="116" width="20" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-13" value="②" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;ellipse;" vertex="1" parent="1"><mxGeometry x="798" y="192" width="20" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-14" value="③" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;ellipse;" vertex="1" parent="1"><mxGeometry x="798" y="252" width="20" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-15" value="&lt;b&gt;理解度チェック&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;3／8 正解&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="456" y="324" width="86" height="132" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-16" value="&lt;b&gt;戦績&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;5勝 2分 3敗&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="550" y="324" width="86" height="132" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-17" value="&lt;b&gt;表現範囲&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;実戦との違い&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="644" y="324" width="86" height="132" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-18" value="&lt;b&gt;設定&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;音量・ヒント&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="738" y="324" width="86" height="132" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-19" value="&lt;b&gt;① 再開カード&lt;/b&gt;&lt;br&gt;中断データが RESUMABLE のときだけ表示。スコアを添える。&lt;br&gt;押すと進行段階（TURN／STYLE_CHANGE／HALFTIME）の画面へ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="460" height="78" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-20" value="&lt;b&gt;② チュートリアル&lt;/b&gt;&lt;br&gt;完了フラグが未完了なら CPU 対戦の直前に置き「はじめての方へ」を付ける。&lt;br&gt;完了後は小さなカードの並びの最後へ移す。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="198" width="460" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-21" value="&lt;b&gt;③ CPU 対戦（KICK OFF）&lt;/b&gt;&lt;br&gt;中断中の試合があれば確認ダイアログ → 了承で S-02 へ（この時点では消さない）。&lt;br&gt;戦績を記録できていない試合があれば、先に記録をやり直し、&lt;br&gt;失敗したときだけ「その戦績は記録されません」と確認する。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="270" width="460" height="94" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-22" value="&lt;b&gt;小さなカード&lt;/b&gt;（横に4つ）&lt;br&gt;理解度チェック・戦績・ゲームの表現範囲・設定。正答状況・通算成績などの一言を添える。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="374" width="460" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-23" value="&lt;b&gt;起動画面&lt;/b&gt;&lt;br&gt;起動時の読み込み中だけ、ロゴのみの画面を出してからこの画面へ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="446" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-24" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="512" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-25" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="518" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-26" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="542" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-27" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="542" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-28" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="890" y="568" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-29" value="条件付きで表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="568" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-30" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="590" width="40" height="12" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-31" value="注記（①②… は画面上の番号）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="586" width="230" height="18" as="geometry"/></