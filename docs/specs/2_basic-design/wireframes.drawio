F;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="351" y="1089" width="16" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-139" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FF8A3D;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;rhombus;" vertex="1" parent="1"><mxGeometry x="438" y="1109" width="14" height="14" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-140" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FF8A3D;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;rhombus;" vertex="1" parent="1"><mxGeometry x="456" y="1109" width="14" height="14" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-141" value="▲" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="351" y="1145" width="16" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-142" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4CC3FF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="388" y="1164" width="16" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-143" value="▼" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="351" y="1201" width="16" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-144" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FF8A3D;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;rhombus;" vertex="1" parent="1"><mxGeometry x="438" y="1221" width="14" height="14" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-145" value="▲" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=none;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="351" y="1257" width="16" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-146" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#4CC3FF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;ellipse;" vertex="1" parent="1"><mxGeometry x="388" y="1276" width="16" height="16" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-147" value="攻撃→" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="438" y="1288" width="56" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-148" style="endArrow=classic;html=1;strokeColor=#F5C518;strokeWidth=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="280.5" y="1130.8" as="sourcePoint"/><mxPoint x="288.0" y="1164.4" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wireframe-s03-match-149" style="endArrow=classic;html=1;strokeColor=#FF8A3D;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="138.0" y="1114.0" as="sourcePoint"/><mxPoint x="235.5" y="1114.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wireframe-s03-match-150" style="endArrow=classic;html=1;strokeColor=#FFFFFF;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="475.5" y="1231.6" as="sourcePoint"/><mxPoint x="475.5" y="1181.2" as="targetPoint"/></mxGeometry></mxCell><mxCell id="wireframe-s03-match-151" value="1 対 0" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F5C518;strokeColor=none;fontSize=10;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="291.0" y="1145.36" width="52" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-152" value="&lt;span style='color:#2563EB'&gt;● 自分 4-3-3 ゾーン・カウンター&lt;/span&gt;&lt;br&gt;&lt;span style='color:#DC2626'&gt;◆ CPU 4-4-2 ゾーン・保持&lt;/span&gt;" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=10;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="1030" width="322" height="36" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-153" value="&lt;b&gt;● ADVANCE 前進&lt;/b&gt;（解説テロップ風。札の地は成功した側の色）&lt;br&gt;中盤（敵陣）・中央で 1対0。数的優位で前進" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3C4;strokeColor=#F5C518;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="1074" width="322" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-154" value="CPU は中盤（敵陣）・左HS へプレス（読み違い）&lt;br&gt;比較エリア　中盤（敵陣）・中央&lt;br&gt;人数　自分 1 対 相手 0&lt;br&gt;カバー　なし" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="1128" width="322" height="84" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-155" value="&lt;span style='color:#B45309'&gt;実戦では: 同じ人数でも、体の向きやパスのタイミングで……&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="510" y="1218" width="322" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-156" value="次のターンへ　NEXT" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="1274" width="322" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-157" value="&lt;b&gt;上部バー&lt;/b&gt;: メニュー（≡）、中継風のスコア表示（スコア・ハーフと残りターン）、局面のタグ（英字の ATTACK など＋日本語の局面名）。開示中は局面のタグの場所に両者の選択の帯（2段）。16:9 の幅に収める。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="480" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-158" value="&lt;b&gt;陣形・方式&lt;/b&gt;（右の列の上端に固定）: 相手の陣形・守備方式・攻撃方式を常に表示（FR-16・21）。チームは色に加えて駒と同じ印（●／◆）で区別（NFR-20）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="182" width="480" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-159" value="&lt;b&gt;作戦ボード&lt;/b&gt;（左）: ピッチを横に置き、攻撃方向が右。上が利用者から見て左のサイド。人数ぶんの選手の駒（自分＝丸・相手＝ひし形、背番号つき）。30エリアは点線。各エリアの角に優劣記号（▲優位 ＝同数 ▼不利）を常に表示。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="238" width="480" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-160" value="&lt;b&gt;手の選択&lt;/b&gt;（右の列）: 選べる手だけを①〜④のボタン（行動の名前だけ）で2列に並べる（行き先はゲームが決める）。行き先・人数・説明は「詳細」のポップアップ（2026-11-05）。盤面には自分の手の行き先に点線の枠と番号の札。手を押すと行き先を塗り、ボールから行き先へ矢印。決定ボタンに要約を書き、押して確定（2026-11-03）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="310" width="480" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-161" value="&lt;b&gt;ヒント&lt;/b&gt;（設定 ON のとき）: 自分の手の行き先の番号の札と「詳細」に、人数差とカバーの有無。最善手の印は付けない（FR-19）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="382" width="480" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-162" value="&lt;b&gt;開示&lt;/b&gt;: 上部バーの局面のタグの場所を両者の選択の帯（2段）に替え、本体と右の列を合わせた場所いっぱいに 3D 演出（REPLAY。スキップ可）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="438" width="480" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-163" value="&lt;b&gt;判定理由&lt;/b&gt;: ボードに戻り、動きの矢印（凡例はボードの左下の隅）と比較エリアの人数の札。右の列に解説テロップ風の判定理由・判定の内訳（比較エリア・人数・カバー）・「実戦では」。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="494" width="480" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-164" value="&lt;b&gt;次へ&lt;/b&gt;: 次のターン／S-04（得点）／S-05（前半終了）／S-06（後半終了）。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="566" width="480" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-165" value="&lt;b&gt;メニュー&lt;/b&gt;: 設定（重ねて開く）／中断してタイトルへ（確認ダイアログ）。Android の戻る操作でも開く。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="622" width="480" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-166" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="688" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-167" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="694" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-168" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="718" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-169" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="718" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-170" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="890" y="744" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-171" value="条件付きで表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="744" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-172" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="766" width="40" height="12" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-173" value="注記（①②… は画面上の番号）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="762" width="230" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="wireframe-s04-style-change" name="wireframe-s04-style-change"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wireframe-s04-style-change-1" value="S-04 方式の選び直し" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="28" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-2" value="得失点後、キックオフ前に守備方式・攻撃方式を選び直す。初期値は現在の方式。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1200" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-3" value="横向き（Android）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="800" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="360" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-5" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=none;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-6" value="≡" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="48" y="114" width="80" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-7" value="方式の選び直し" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="136" y="114" width="400" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-8" value="&lt;b&gt;CPU が得点しました&lt;/b&gt;&lt;br&gt;自分 1 − 1 CPU" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=14;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="166" width="440" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-9" value="&lt;span style='color:#DC2626'&gt;◆ CPU 4-4-2／マンツーマン／カウンター型&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="230" width="440" height="36" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-10" value="&lt;b&gt;直前の噛み合わせ&lt;/b&gt;（自分 ゾーン・保持型 × CPU マンツーマン・カウンター型）&lt;br&gt;保持型で大外が前に出た背後を、カウンターで突かれやすい……" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56" y="274" width="440" height="180" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-11" value="守備方式" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="166" width="322" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-12" value="ゾーン" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510.0" y="190" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-13" value="マンツーマン" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="671.0" y="190" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-14" value="攻撃方式" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="246" width="322" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-15" value="保持型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510.0" y="270" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-16" value="カウンター型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="671.0" y="270" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-17" value="キックオフ" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="414" width="322" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-18" value="&lt;b&gt;得点の知らせ・スコア&lt;/b&gt;（左）&lt;br&gt;誰が得点したかと現在のスコア。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-19" value="&lt;b&gt;噛み合わせの解説&lt;/b&gt;（左）&lt;br&gt;直前の方式区間の、両者の方式の組み合わせから導く。&lt;br&gt;方式を選び替えると、選んだ方式の単独の解説を下に足す。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="166" width="460" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-20" value="&lt;b&gt;キックオフ&lt;/b&gt;（右の列の下端）&lt;br&gt;失点側のキックオフで S-03 へ。両者の方式を開示する。&lt;br&gt;ヘッダーはメニュー（≡）。戻るボタンは無い。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="238" width="460" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-21" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="320" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-22" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="326" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-23" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="350" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-24" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="350" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-25" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="890" y="376" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-26" value="条件付きで表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="376" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-27" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="398" width="40" height="12" as="geometry"/></mxCell><mxCell id="wireframe-s04-style-change-28" value="注記（①②… は画面上の番号）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="394" width="230" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="wireframe-s05-halftime" name="wireframe-s05-halftime"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wireframe-s05-halftime-1" value="S-05 ハーフタイム" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="28" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-2" value="前半の噛み合わせを見て、陣形と方式を選び直す。初期値は前半の陣形・方式。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1200" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-3" value="横向き（Android）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="800" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="360" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-5" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=none;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-6" value="≡" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="48" y="114" width="80" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-7" value="ハーフタイム" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="136" y="114" width="400" height="40" as="geometry"