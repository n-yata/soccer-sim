rent="1"><mxGeometry x="56" y="474" width="328" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-34" value="ゾーン" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56.0" y="498" width="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-35" value="マンツーマン" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220.0" y="498" width="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-36" value="攻撃方式" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="554" width="328" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-37" value="保持型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="56.0" y="578" width="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-38" value="カウンター型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="220.0" y="578" width="164.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s05-halftime-39" value="後半開始" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6