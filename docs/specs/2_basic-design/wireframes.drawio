=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="403" y="392" width="36" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-79" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#81C784;fontSize=9;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="403" y="410" width="36" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-80" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#81C784;fontSize=9;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="403" y="428" width="36" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-81" value="② 守備方式" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="162" width="322" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-82" value="ゾーン" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=13;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510.0" y="186" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-83" value="マンツーマン" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="671.0" y="186" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-84" value="③ 攻撃方式" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="240" width="322" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-85" value="保持型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510.0" y="264" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-86" value="カウンター型" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="671.0" y="264" width="161.0" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-87" value="&lt;b&gt;④ 解説&lt;/b&gt;&lt;br&gt;4-3-3: 前線3人で幅を取り、両ウイングが大外に張る……&lt;br&gt;ゾーン: ボールサイドへ1レーンずれて圧縮する……&lt;br&gt;&lt;span style='color:#B45309'&gt;実戦では: …&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="510" y="320" width="322" height="86" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-88" value="この布陣で試合開始" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#E2E8F0;fontSize=14;fontColor=#64748B;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="510" y="414" width="322" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-89" value="&lt;b&gt;① 陣形カード&lt;/b&gt;（4つ、2×2）&lt;br&gt;ミニピッチは基本配置の人数（横置き。攻撃方向が右）。選んだカードに枠と ✓。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-90" value="&lt;b&gt;②③ 方式&lt;/b&gt;&lt;br&gt;2択。どちらも未選択から始める。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="166" width="460" height="46" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-91" value="&lt;b&gt;④ 解説&lt;/b&gt;&lt;br&gt;選んだ項目の解説だけを出す（相手は未定なので単独の解説）。&lt;br&gt;長いときは欄の中でスクロール。単純化に関わる記述には「実戦では」。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="222" width="460" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-92" value="&lt;b&gt;開始ボタン&lt;/b&gt;&lt;br&gt;3項目すべてを選ぶまで押せない（図は ③ 未選択の状態）。&lt;br&gt;押すと S-03 へ。試合画面で両者の陣形・方式を開示する。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="880" y="294" width="460" height="62" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-93" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="376" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-94" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="382" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-95" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="406" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-96" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="406" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-97" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="890" y="432" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-98" value="条件付きで表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="432" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-99" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="454" width="40" height="12" as="geometry"/></mxCell><mxCell id="wireframe-s02-match-setup-100" value="注記（①②… は画面上の番号）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="938" y="450" width="230" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="wireframe-s03-match" name="wireframe-s03-match"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wireframe-s03-match-1" value="S-03 試合" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="28" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-2" value="上から: ①手の選択中 ②開示（3D 演出） ③判定理由の表示。横向き（Android）のみ。左に作戦ボード、右に操作の列。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1200" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-3" value="① 手の選択中（ヒント ON）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="800" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="800" height="360" as="geometry"/></mxCell><mxCell id="wireframe-s03-match-5" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=none;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" 