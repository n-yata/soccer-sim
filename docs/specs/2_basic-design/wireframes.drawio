<mxfile host="drawio" pages="12"><diagram id="wireframe-s01-title" name="wireframe-s01-title"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wireframe-s01-title-1" value="S-01 タイトル" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=18;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1000" height="28" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-2" value="各機能への入口。中断中の試合があるときだけ再開カードを出す。チュートリアル未完了なら先頭に「はじめての方へ」。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="1200" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-3" value="縦向き（Android）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="360" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="800" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-5" value="soccer-game（仮称）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="360" height="50" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-6" value="読み合いで戦術を学ぶボードゲーム" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="198" width="360" height="22" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-7" value="①" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;ellipse;" vertex="1" parent="1"><mxGeometry x="46" y="242" width="20" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-8" value="&lt;b&gt;中断した試合を再開&lt;/b&gt;&lt;br&gt;前半 7／12　自分 1 − 0 CPU" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="64" y="240" width="312" height="80" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-9" value="②" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D6B656;strokeColor=#D6B656;fontSize=10;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;ellipse;" vertex="1" parent="1"><mxGeometry x="46" y="342" width="20" height="20" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-10" value="&lt;b&gt;チュートリアル&lt;/b&gt;　&lt;span style='color:#B45309'&gt;はじめての方へ&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=14;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="64" y="340" width="312" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-11" value="CPU 対戦" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1D4ED8;strokeColor=#1D4ED8;fontSize=14;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="412" width="312" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-12" value="理解度チェック" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=14;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="476" width="312" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-13" value="ゲームの表現範囲" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=14;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="536" width="312" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-14" value="戦績" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=14;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="596" width="312" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-15" value="設定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=14;fontColor=#1D4ED8;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="656" width="312" height="48" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-16" value="（チュートリアル完了後は、チュートリアルを「設定」の上に移す）" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=10;fontColor=#475569;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="64" y="770" width="312" height="40" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-17" value="&lt;b&gt;① 再開カード&lt;/b&gt;&lt;br&gt;中断データが RESUMABLE のときだけ表示。&lt;br&gt;押すと進行段階（TURN／STYLE_CHANGE／HALFTIME）の画面へ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="110" width="420" height="73" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-18" value="&lt;b&gt;② チュートリアル&lt;/b&gt;&lt;br&gt;完了フラグが未完了なら先頭に置き「はじめての方へ」を付ける。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="193" width="420" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-19" value="&lt;b&gt;CPU 対戦&lt;/b&gt;&lt;br&gt;中断中の試合があれば確認ダイアログ → 了承で S-02 へ（この時点では消さない）。&lt;br&gt;戦績を記録できていない試合があれば、先に記録をやり直し、&lt;br&gt;失敗したときだけ「その戦績は記録されません」と確認する。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="259" width="420" height="90" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-20" value="&lt;b&gt;起動画面&lt;/b&gt;&lt;br&gt;起動時の読み込み中だけ、ロゴのみの画面を出してからこの画面へ。" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="359" width="420" height="56" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-21" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="460" y="435" width="300" height="96" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-22" value="凡例" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="441" width="280" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-23" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="465" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-24" value="常に表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="518" y="465" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-25" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F172A;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="470" y="491" width="40" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-26" value="条件付きで表示する要素" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;fontColor=#0F172A;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="518" y="491" width="230" height="18" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-27" value="" style="rounded=0;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7D6;strokeColor=#D6B656;fontSize=12;fontColor=#0F172A;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="470" y="513" width="40" height="12" as="geometry"/></mxCell><mxCell id="wireframe-s01-title-28" value="注記（①②… は画面上の番号）" style