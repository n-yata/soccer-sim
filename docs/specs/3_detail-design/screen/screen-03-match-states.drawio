<mxfile host="drawio" pages="1"><diagram id="s03-match-states" name="s03-match-states"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s03st-1" value="&lt;b&gt;S-03 試合画面の状態遷移&lt;/b&gt;（screen-03-match.md「画面の状態」）" style="text;html=1;fontSize=16;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="30" as="geometry"/></mxCell><mxCell id="s03st-2" value="" style="ellipse;html=1;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="296" y="62" width="28" height="28" as="geometry"/></mxCell><mxCell id="s03st-3" value="&lt;b&gt;SELECT_ACTION&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;手を選んでいない&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="200" y="118" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-4" value="&lt;b&gt;SELECT_TARGET&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;運ぶ先のエリアを選んでいない&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="600" y="118" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-5" value="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;手（とエリア）を選び終えた&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="600" y="338" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-6" value="&lt;b&gt;SUBMITTING&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;「決定」の結果を待つ（入力を止める）&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="600" y="498" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-7" value="&lt;b&gt;REPLAYING&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;両者の選択の帯と 3D 演出&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="600" y="658" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-8" value="&lt;b&gt;SHOW_RESULT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;動きの矢印と判定理由&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="600" y="818" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-9" value="&lt;b&gt;LEAVING&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#475569'&gt;画面の切り替えを待つ（入力を止める）&lt;/span&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="200" y="818" width="220" height="64" as="geometry"/></mxCell><mxCell id="s03st-10" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#0F172A;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="294" y="960" width="32" height="32" as="geometry"/></mxCell><mxCell id="s03st-11" value="enter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-2" target="s03st-3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-12" value="運ぶ先を持つ手を選ぶ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-3" target="s03st-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-13" value="運ぶ先を持たない手を選ぶ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-3" target="s03st-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="370"/></Array></mxGeometry></mxCell><mxCell id="s03st-14" value="選べるエリアを選ぶ&lt;br&gt;運ぶ先なしの手に選び直す" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-4" target="s03st-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-15" value="運ぶ先を持つ&lt;br&gt;別の手を選ぶ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-5" target="s03st-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-16" value="エリア・手の&lt;br&gt;選び直し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-5" target="s03st-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="357"/><mxPoint x="870" y="383"/></Array></mxGeometry></mxCell><mxCell id="s03st-17" value="「決定」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-5" target="s03st-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-18" value="turn_resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-6" target="s03st-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-19" value="submit_turn が false&lt;br&gt;（選択をやり直す）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="s03st-6" target="s03st-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="343" y="530"/></Array></mxGeometry></mxCell><mxCell id="s03st-20" value="ReplayStage.finished&lt;br&gt;（スキップを含む）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-7" target="s03st-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-21" value="「次へ」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-8" target="s03st-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-22" value="state_changed&lt;br&gt;（TURN のまま）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-9" target="s03st-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="850"/><mxPoint x="140" y="150"/></Array></mxGeometry></mxCell><mxCell id="s03st-23" value="別の画面へ&lt;br&gt;（S-04／S-05／S-06）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#0F172A;fontSize=11;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s03st-9" target="s03st-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s03st-24" value="凡例: 角丸の箱＝状態　実線＝通常の遷移　破線＝例外の遷移（通常は起きない）&lt;br&gt;メニュー・設定・確認ダイアログは、どの状態の上にも重ねて開き、状態は変えない（下の画面の入力だけを止める）。メニューを開けるのは SELECT_ACTION・SELECT_TARGET・READY・SHOW_RESULT のとき" style="text;html=1;fontSize=11;fontColor=#475569;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="900" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
